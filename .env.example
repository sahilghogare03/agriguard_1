# Supabase Configuration
# Fill in your Supabase Project URL and API Key below to connect AgriGuard AI history to Supabase

SUPABASE_URL=https://your-supabase-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-or-service-role-key

# SQL Setup for Supabase SQL Editor:
# Run the following SQL query in your Supabase SQL Editor:
#
# 1. Users & Admin Table:
# CREATE TABLE IF NOT EXISTS users (
#     id TEXT PRIMARY KEY,
#     email TEXT UNIQUE NOT NULL,
#     name TEXT,
#     role TEXT DEFAULT 'user',
#     created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
# );
#
# 2. Prediction History Table (Isolated per user):
# CREATE TABLE IF NOT EXISTS prediction_history (
#     id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
#     user_email TEXT NOT NULL,
#     disease TEXT NOT NULL,
#     confidence FLOAT NOT NULL,
#     health_status TEXT NOT NULL,
#     description TEXT,
#     treatment TEXT,
#     prevention TEXT,
#     image_path TEXT,
#     created_at TIMESTAMP WITH TIME ZONE DEFAULT TIMEZONE('utc'::text, NOW()) NOT NULL
# );
#
# 3. Grant table permissions & disable RLS:
# ALTER TABLE users DISABLE ROW LEVEL SECURITY;
# ALTER TABLE prediction_history DISABLE ROW LEVEL SECURITY;
# GRANT ALL ON TABLE users TO anon, authenticated, service_role;
# GRANT ALL ON TABLE prediction_history TO anon, authenticated, service_role;
# ALTER TABLE prediction_history ADD COLUMN IF NOT EXISTS user_email TEXT;
